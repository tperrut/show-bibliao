{
  "name": "show-biblao",
  "version": "2.0.0",
  "private": true,
  "description": "Show do Biblião - jogo de perguntas bíblicas",
  "scripts": {
    "seed": "node scripts/importSeed.js",
    "seed:2026": "node tools/importQuestionarios2026.js",
    "backfill:year": "node tools/backfillYear.js",
    "start": "npx serve . --config serve.json",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "test:rules": "firebase emulators:exec --only firestore --project demo-show-biblao \"node --test\""
  },
  "dependencies": {
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^14.27.0",
    "terser": "^5.16.0"
  }
}
