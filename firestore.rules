rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Leitura pública para o jogo funcionar sem login.
    // Escrita restrita ao admin (email definido abaixo).
    match /questionnaires/{questionnaireId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /questions/{questionId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == 'thi.perrut@gmail.com';
    }
  }
}